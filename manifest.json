{
  "manifest_version": 3,
  "name": "YouTube Improvement",
  "version": "1.2.0",
  "description": "Full screen inside the browser tab, plus a Gemini summary of every YouTube video before you press play.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["defaults.js", "transcript.js", "youchat.js", "content.js", "fullwindow.js"],
      "css": ["panel.css", "fullwindow.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "YouTube Improvement settings" }
}
